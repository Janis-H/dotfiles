#!/bin/sh

# LightDM on Debian/Mint normally wraps every session in /etc/X11/Xsession.
# A Wayland compositor needs to start directly after LightDM activates its VT;
# otherwise wlroots can time out waiting for an active DRM session.
if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
    sleep 1
    exec "$@"
fi

exec /etc/X11/Xsession "$@"
