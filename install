#!/usr/bin/env bash
# Installs system packages and external tools for the detected OS

set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# --- Sources ---
source "$DOTFILES_DIR/lib/detect-os.sh"
source "$DOTFILES_DIR/lib/log.sh"
source "$DOTFILES_DIR/installers/post-install.sh"

# --- Helpers ---
print_usage() {
    local script_name
    script_name="./$( basename "$0")"

    cat <<EOF
Usage:
    $script_name [options]

Description:

Options:
    -h    Show this help message

Examples:
    $script_name                    # Install
EOF
}

# --- Parse arguments ---
# TODO: consider adding profile flags later for core, server and desktop
while getopts ":uh" option; do
    case "$option" in
        h)
            print_usage
            exit 0
            ;;
        *)
            error "Invalid option: $OPTARG"
            print_usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))


# --- Detect os ---
os="$(detect_os)"

# --- Installer selection ---
case "$os" in
    debian|arch|macos)
        source "$DOTFILES_DIR/installers/$os.sh"
        ;;
    *)
        info "Unsupported OS: $os" >&2
        exit 1
        ;;
esac

# --- Install flow ---
title "Script Info"
info "OS: $os"

title "Installing packages"
install_packages

title "Running Post Install"
run_post_install
