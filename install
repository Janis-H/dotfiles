#!/usr/bin/env bash
# Installs system packages and external tools for the detected OS

set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# source helper functions
source "$DOTFILES_DIR/lib/detect-os.sh"
source "$DOTFILES_DIR/lib/log.sh"

# source post-install
source "$DOTFILES_DIR/installers/post-install.sh"

# detect os
os="$(detect_os)"

title "Script Info"
info "OS: $os"

# install packages
title "Starting Package Install"

case "$os" in
    debian|arch|macos)
        source "$DOTFILES_DIR/installers/$os.sh"
        install_packages
        ;;
    *)
        info "Unsupported OS: $os" >&2
        exit 1
        ;;
esac

# post-install setup after package and external tool instalation
run_post_install
