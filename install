#!/usr/bin/env bash
# Installs system packages and external tools for the detected OS

# shellcheck disable=SC1090

set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# --- Sources ---
source "$DOTFILES_DIR/lib/log.sh"
source "$DOTFILES_DIR/lib/detect-os.sh"
source "$DOTFILES_DIR/lib/run-command.sh"

source "$DOTFILES_DIR/lib/validate-profile.sh"
source "$DOTFILES_DIR/lib/validate-os.sh"
source "$DOTFILES_DIR/lib/validate-manifest.sh"

source "$DOTFILES_DIR/lib/build-system-casks-for-profile.sh"
source "$DOTFILES_DIR/lib/build-system-packages-for-profile.sh"
source "$DOTFILES_DIR/lib/build-external-tools-for-profile.sh"

source "$DOTFILES_DIR/installers/system-runner.sh"
source "$DOTFILES_DIR/installers/external-runner.sh"
source "$DOTFILES_DIR/installers/post-install-runner.sh"


# --- Helpers ---
print_usage() {
    local script_name
    script_name="./$( basename "$0")"

    cat <<EOF
Usage:
    $script_name [-n] [-p PROFILE]

Description:
    Install core packages and external tools for the detected OS.
    The desktop profile is used by default

Options:
    -n              Dry run. Preview commands without running them.
    -p PROFILE      Select profile. Default: desktop.
    -h              Show this help message

Profiles:
    core            Minimal terminal and dotfiles setup
    headless        Core + non-GUI development/build tools
    desktop         Headless + development/build tools + GUI/workstation tools

Examples:
    $script_name
    $script_name -n
    $script_name -p core
    $script_name -p headless
    $script_name -n -p desktop
EOF
}

print_script_info() {
    title "Script Info"

    info "Script: $( basename "$0" )"
    info "OS: $OS"
    info "Profile: $PROFILE"
    info "Dry run: ${DRY_RUN:-false}"
}

# --- Parse arguments ---
PROFILE="desktop"
DRY_RUN=false

while getopts ":np:h" option; do
    case "$option" in
        n)
            title "Dry run enabled. No system changes will be made."
            DRY_RUN=true
            ;;
        p)
            validate_profile "$OPTARG" || exit 1
            PROFILE="$OPTARG"
            ;;
        h)
            print_usage
            exit 0
            ;;
        :)
            error "Option -$OPTARG requires an argument"
            print_usage
            exit 1
            ;;
        *)
            error "Invalid option: -$OPTARG"
            print_usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

# --- Detect os ---
OS="$(detect_os)"

validate_os "$OS" || exit 1

# --- Build package lists ---
source "$DOTFILES_DIR/manifests/$OS.sh"

validate_manifest "$OS" || exit 1

SYSTEM_PACKAGES=()
SYSTEM_CASKS=()
EXTERNAL_TOOLS=()

build_system_packages_for_profile "$PROFILE" || exit 1
build_system_casks_for_profile "$PROFILE" || exit 1
build_external_tools_for_profile "$PROFILE" || exit 1

# --- Install flow ---
print_script_info

run_system_installs "$OS" "${SYSTEM_PACKAGES[@]}"

if [[ "$OS" == "macos" ]]; then
    install_system_casks "$OS" "${SYSTEM_CASKS[@]}"
fi

run_external_installs "$OS" "${EXTERNAL_TOOLS[@]}"

run_post_install "$OS"
