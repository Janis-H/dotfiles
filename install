#!/usr/bin/env bash
# Installs system packages and external tools for the detected OS

set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# --- Sources ---
source "$DOTFILES_DIR/lib/log.sh"
source "$DOTFILES_DIR/lib/detect-os.sh"

source "$DOTFILES_DIR/lib/validate-profile.sh"
source "$DOTFILES_DIR/lib/validate-os.sh"
source "$DOTFILES_DIR/lib/validate-manifest.sh"

source "$DOTFILES_DIR/lib/build-casks-for-profile.sh"
source "$DOTFILES_DIR/lib/build-packages-for-profile.sh"
source "$DOTFILES_DIR/lib/build-external-tools-for-profile.sh"

source "$DOTFILES_DIR/installers/external/runner.sh"
source "$DOTFILES_DIR/installers/post-install.sh"

# --- Helpers ---
print_usage() {
    local script_name
    script_name="./$( basename "$0")"

    # TODO: look into adding dry run option
    cat <<EOF
Usage:
    $script_name [options]

Description:
    Install core packages and external tools for the detected OS.
    Core tools are always installed. Use a profile to add server or desktop tools.

Options:
    -p PROFILE  Install package profile: core, server, or desktop
                Default: core

                Profiles:
                    core     Bare terminal/dotfiles setup
                    server   Core + development/build tools
                    desktop  Server + GUI/workstation tools

    -h          Show this help message

Examples:
    $script_name                # Install core
    $script_name -p core        # Install core + server
    $script_name -p server      # Install core + server
    $script_name -p desktop     # Install core + server + desktop
EOF
}

# --- Parse arguments ---
PROFILE="core"

while getopts ":p:h" option; do
    case "$option" in
        p)
            validate_profile "$OPTARG" || exit 1
            PROFILE="$OPTARG"
            ;;
        :)
            error "option missing argument"
            print_usage
            exit 1
            ;;
        h)
            print_usage
            exit 0
            ;;
        *)
            error "Invalid option: $OPTARG"
            print_usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

# --- Detect os ---
os="$(detect_os)"

validate_os "$os" || exit 1

# --- Build package lists ---
source "$DOTFILES_DIR/manifests/$os.sh"

validate_manifest || exit 1

PACKAGES=()
CASKS=()
EXTERNAL_TOOLS=()

build_packages_for_profile "$PROFILE" || exit 1
build_casks_for_profile "$PROFILE" || exit 1
build_external_tools_for_profile "$PROFILE"|| exit 1

# --- Installer selection ---
source "$DOTFILES_DIR/installers/$os.sh"
source "$DOTFILES_DIR/installers/external/$os.sh"

# --- Install flow ---
title "Script Info"
info "PROFILE: $PROFILE"
info "OS: $os"

title "Installing packages..."
install_packages "${PACKAGES[@]}"

title "Installing external tools..."
install_external_tools "${EXTERNAL_TOOLS[@]}"

if [[ $os == "macos" && "${#CASKS[@]}" -gt 0 ]]; then
    title "Installling casks..."
    install_casks "${CASKS[@]}"
fi

# title "Running Post Install"
# run_post_install
