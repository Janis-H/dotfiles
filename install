#!/usr/bin/env bash
# Installs system packages and external tools for the detected OS

set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# --- Sources ---
source "$DOTFILES_DIR/lib/detect-os.sh"
source "$DOTFILES_DIR/lib/log.sh"
source "$DOTFILES_DIR/installers/post-install.sh"

# --- Helpers ---
print_usage() {
    local script_name
    script_name="./$( basename "$0")"

    # TODO: look into adding dry run option
    cat <<EOF
Usage:
    $script_name [options]

Description:
    Install core packages and external tools for the detected OS.
    Core tools are always installed. Use a profile to add server or desktop tools.

Options:
    -p PROFILE  Install package profile: core, server, or desktop
                Default: core

                Profiles:
                    core     Bare terminal/dotfiles setup
                    server   Core + development/build tools
                    desktop  Server + GUI/workstation tools

    -h          Show this help message

Examples:
    $script_name                # Install core
    $script_name -p server      # Install core + server
    $script_name -p desktop     # Install core + server + desktop
EOF
}

validate_profile() {
    local profile="$1"

    case "$profile" in
        core|server|desktop)
            ;;
        *)
            error "Invalid profile option: $profile"
            print_usage
            exit 1
    esac
}

# --- Parse arguments ---
PROFILE="core"

while getopts ":p:h" option; do
    case "$option" in
        p)
            validate_profile "$OPTARG"
            PROFILE="$OPTARG"
            ;;
        :)
            error "Missing argument"
            print_usage
            exit 1
            ;;
        h)
            print_usage
            exit 0
            ;;
        *)
            error "Invalid option: $OPTARG"
            print_usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

# --- Detect os ---
os="$(detect_os)"

# --- Installer selection ---
case "$os" in
    debian|arch|macos)
        source "$DOTFILES_DIR/installers/$os.sh"
        ;;
    *)
        error "Unsupported OS: $os"
        exit 1
        ;;
esac

# --- Install flow ---
title "Script Info"
info "OS: $os"

# title "Installing packages"
# install_packages

# title "Running Post Install"
# run_post_install
