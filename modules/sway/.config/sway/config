### Startup
#
# Exec:
#
    # Applies the configured monitor layout after Sway starts
    exec ~/.local/bin/fix-monitors-sway

    # TODO: uncomment below once waybar has been installed and setup

    # Starts the Waybar status bar
    # exec waybar
#
# Exec-always:
#
    # Automatically chooses horizontal or vertical splits based on window dimensions
    exec_always autotiling

