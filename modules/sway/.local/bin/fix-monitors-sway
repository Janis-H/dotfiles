#!/usr/bin/env bash

set -euo pipefail

PRIMARY_DISPLAY="DP-1"
SECONDARY_DISPLAY="DP-2"

PRIMARY_MODE="2560x1440@144Hz"
SECONDARY_MODE="2560x1440@60Hz"
HDMI_MODE="1024x576@60Hz"

if [[ -z ${SWAYSOCK:-} ]]; then
    printf 'This script must run inside Sway\n' >&2
    exit 1
fi

HDMI_OUTPUT="$(
    swaymsg -r -t get_outputs |
        jq -r '
            .[]
            | select(.active)
            | select(.name | startswith("HDMI"))
            | .name
        ' |
        head -n 1
)"

PRIMARY_X=0

if [[ -n "$HDMI_OUTPUT" ]]; then
    swaymsg output "$HDMI_OUTPUT" \
        mode "$HDMI_MODE" \
        transform flipped \
        position 0 0

    PRIMARY_X=1024
fi

swaymsg output "$PRIMARY_DISPLAY" \
    mode "$PRIMARY_MODE" \
    transform normal \
    position "$PRIMARY_X" 0

swaymsg output "$SECONDARY_DISPLAY" \
    mode "$SECONDARY_MODE" \
    transform 90 \
    position "$((PRIMARY_X + 2560))" 0
