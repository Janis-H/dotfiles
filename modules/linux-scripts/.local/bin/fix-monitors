#!/usr/bin/env bash

# TODO: move script under i3 modules folder instead of linux-scripts

# TODO: create fix-monitors script for sway.
# xrandr is not supported by wayland; therefore, a replacement
# will be needed once the transition to sway (wayland) is complete

sleep 3

PRIMARY_DISPLAY="DisplayPort-0"
SECONDARY_DISPLAY="DisplayPort-1"

HDMI_OUTPUT="$(xrandr --query | awk '/^HDMI.* connected/ {print $1; exit}')"

# Primary monitor
xrandr --output "$PRIMARY_DISPLAY" \
  --primary \
  --mode 2560x1440 \
  --rate 144.00 \
  --rotate normal

# Right portrait monitor
xrandr --output "$SECONDARY_DISPLAY" \
  --mode 2560x1440 \
  --rate 60.00 \
  --rotate right \
  --right-of "$PRIMARY_DISPLAY"

# Left HDMI monitor
if [ -n "$HDMI_OUTPUT" ]; then
  xrandr --output "$HDMI_OUTPUT" \
    --mode 1024x576 \
    --rate 60.00 \
    --reflect y \
    --left-of "$PRIMARY_DISPLAY"
fi
