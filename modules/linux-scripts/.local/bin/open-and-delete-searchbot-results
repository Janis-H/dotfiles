#!/usr/bin/env bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LIB_PATH="$SCRIPT_DIR/lib"

# Target dir
DOWNLOAD_DIR="$HOME/Downloads";

# source zenity functions
# shellcheck source="lib/display_info_message.sh"
source "${LIB_PATH}/display_info_message.sh"
# shellcheck source="lib/prompt_user.sh"
source "${LIB_PATH}/prompt_user.sh"

# find SearchBot File
display_info_message.sh "Opening file..."
ag -g "searchbot" "$DOWNLOAD_DIR" | xargs -d '\n' open;

# wait for User Input
prompt_user "Press any key to delete searchbot file...";

# Delete File
display_info_message.sh "Deleting file..."
ag -g "searchbot" "$DOWNLOAD_DIR" | xargs -d '\n' rm;
