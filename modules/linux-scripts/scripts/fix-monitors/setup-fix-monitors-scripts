#!/usr/bin/env bash

SETUP_SCRIPT_DIR="$(cd -- "$( dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_FILES_DIR="$SETUP_SCRIPT_DIR/script-files"

# Setup desktop script
DESKTOP_FILE="$SCRIPT_FILES_DIR/fix-monitors.desktop"
DESKTOP_CONFIG_DIR="$HOME/.config/autostart"
mkdir -p "$DESKTOP_CONFIG_DIR" && cp "$DESKTOP_FILE" "$DESKTOP_CONFIG_DIR"

# Setup sleep hook
SLEEP_HOOK="$SCRIPT_FILES_DIR/fix-monitors.sleep-hook.sh"
SLEEP_DIR="/lib/systemd/system-sleep"
install -m 755 "$SLEEP_HOOK" "${SLEEP_DIR}/fix-monitors"
