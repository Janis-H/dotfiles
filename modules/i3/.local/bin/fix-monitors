#!/usr/bin/env bash

# TODO: rename script to fix-monitors-x11
# TODO: once fix-monitors-x11 rename is done, update desktop and sleep hook

set -euo pipefail

sleep 3

PRIMARY_DISPLAY="DisplayPort-0"
SECONDARY_DISPLAY="DisplayPort-1"

HDMI_OUTPUT="$(
    xrandr --query |
        awk '/^HDMI.* connected/ { print $1; exit }'
)"

# Primary monitor
xrandr --output "$PRIMARY_DISPLAY" \
  --primary \
  --mode 2560x1440 \
  --rate 144.00 \
  --rotate normal

# Right portrait monitor
xrandr --output "$SECONDARY_DISPLAY" \
  --mode 2560x1440 \
  --rate 60.00 \
  --rotate right \
  --right-of "$PRIMARY_DISPLAY"

# Left HDMI monitor
if [ -n "$HDMI_OUTPUT" ]; then
  xrandr --output "$HDMI_OUTPUT" \
    --mode 1024x576 \
    --rate 60.00 \
    --reflect y \
    --left-of "$PRIMARY_DISPLAY"
fi

# Set wallpaper
wallpaper="$HOME/.local/share/wallpapers/dark-mountain-landscape.jpg"

# Set seperate outputs, settings and wallpapers
# xwallpaper \
#     --output "$PRIMARY_DISPLAY" --zoom  "$wallpaper" \
#     --output "$SECONDARY_DISPLAY" --zoom "$wallpaper" \
#     --output "$HDMI_OUTPUT" --zoom "$wallpaper"

# Set all outputs to the same wallpaper
xwallpaper --zoom "$wallpaper"
