#!/usr/bin/env bash
# Unstows the default OS-specific set of dotfile modules from $HOME

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STOW_SETS_DIR="$DOTFILES_DIR/stow-sets"

# --- Source helper functions ---
source "${DOTFILES_DIR}/lib/log.sh"
source "${DOTFILES_DIR}/lib/detect-os.sh"
source "${DOTFILES_DIR}/lib/stow-actions.sh"

# --- OS info ---
os="$(detect_os)"
info "OS: $os"

# --- Source OS-specific stow modules ---
source "$STOW_SETS_DIR/common.sh"
source "$STOW_SETS_DIR/$os.sh"

# --- Stow config files ---
unstow_all_modules \
    "${COMMON_MODULES[@]}" \
    "${OS_MODULES[@]}"
