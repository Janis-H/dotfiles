#!/usr/bin/env bash
# Stows or unstows selected or default dotfile modules for the detected OS

# shellcheck disable=SC1090

set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# --- Sources ---
source "$DOTFILES_DIR/lib/log.sh"
source "$DOTFILES_DIR/lib/detect-os.sh"
source "$DOTFILES_DIR/lib/run-command.sh"

source "$DOTFILES_DIR/lib/validate-profile.sh"
source "$DOTFILES_DIR/lib/validate-os.sh"
source "$DOTFILES_DIR/lib/validate-manifest.sh"

source "$DOTFILES_DIR/lib/build-default-modules-for-profile.sh"

source "$DOTFILES_DIR/lib/stow-actions.sh"

# --- Helpers ---
print_usage() {
    local script_name
    script_name="./$( basename "$0")"

    # TODO: consider adding an option to delete orphans
    cat <<EOF
Usage:
    $script_name [options] [modules...]

Description:
    Stow modules by default.
    If no modules are provided, modules are selected from the active profile.
    If modules are provided, only those modules are used.

Options:
    -n              Dry run. Preview changes without modifying files.
    -u              Unstow modules
    -r              Restow modules
    -p PROFILE      Select profile. Default: desktop.
    -h              Show this help message

Profiles:
    core            Minimal terminal and dotfiles setup
    headless        Core + non-GUI development/build tools
    desktop         Headless + GUI/workstation tools

Notes:
    -u and -r cannot be used together
    -p only matters when no modules are provided

Examples:
    $script_name
    $script_name -p desktop
    $script_name nvim zsh tmux
    $script_name -n -p desktop
    $script_name -u nvim
    $script_name -r -p desktop
EOF
}

run_stow_action() {
    local stow_action="$1"
    shift

    case "$stow_action" in
        stow)
            title "Stowing modules"
            stow_modules "$@"
            ;;
        unstow)
            title "Unstowing modules"
            unstow_modules "$@"
            ;;
        restow)
            title "Restowing modules"
            restow_modules "$@"
            ;;
        *)
            error "Invalid stow action: $stow_action"
            ;;
    esac
}

# --- Parse arguments ---
stow_action="stow"

DRY_RUN=false
PROFILE="desktop"

while getopts ":nurp:h" option; do
    case "$option" in
        n)
            title "Dry run enabled. No system changes will be made."
            DRY_RUN=true
            ;;
        p)
            validate_profile "$OPTARG" || exit 1
            PROFILE="$OPTARG"
            ;;
        u)
            stow_action="unstow"
            ;;
        r)
            stow_action="restow"
            ;;
        h)
            print_usage
            exit 0
            ;;
        :)
            error "Option -$OPTARG requires an argument"
            print_usage
            exit 1
            ;;
        *)
            error "Invalid option: -$OPTARG"
            print_usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

# --- Detect os ---
OS="$(detect_os)"

validate_os "$OS" || exit 1

# --- Build default modules ---
source "$DOTFILES_DIR/manifests/$OS.sh"

validate_manifest || exit 1

DEFAULT_MODULES=()

build_default_modules_for_profile "$PROFILE" || exit 1

# --- Select target modules ---
if [[ "$#" -gt 0 ]]; then
    target_modules=("$@")
else
    target_modules=("${DEFAULT_MODULES[@]}")
fi

# --- Debug ---
# printf '%s\n' "${target_modules[@]}"

# --- Stow / unstow modules ---
title "Script Info"
info "PROFILE: $PROFILE"
info "OS: $OS"

run_stow_action "$stow_action" "${target_modules[@]}"
