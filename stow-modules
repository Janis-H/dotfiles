#!/usr/bin/env bash
# Stows the default OS-specific set of dotfiles modules into $HOME

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STOW_SETS_DIR="$DOTFILES_DIR/stow-sets"

# --- Sources ---
source "${DOTFILES_DIR}/lib/log.sh"
source "${DOTFILES_DIR}/lib/detect-os.sh"
source "${DOTFILES_DIR}/lib/stow-actions.sh"

# --- Parse Arguments ---
# TODO: add argument parsing
# defaults:
#   - by default, stows and unstows default packages
# argument types
#   - "--selected" : accepts list of modules to stow
#   - "--unstow" : unstows default or if --selected flag is included, unstows selected
#
# default values
stow_or_unstow="stow"
default_or_selected_modules="default"

modules_to_stow=()

print_usage() {
    echo "Usage:"
    echo "  $0                  Stow default modules"
    echo "  $0 -u               Unstow default modules"
    echo "  $0 modules...       Stow selected modules"
    echo "  $0 -u modules...    Unstow selected modules"
    echo ""
    echo "Options:"
    echo "  -u    Unstow instead of stow"
    echo "  -h    Show this help message"
}

# iterate over arguments
for arg in "$@"; do
    case "$arg" in
        -u)
            stow_or_unstow="unstow"
            ;;
        -h)
            print_usage
            ;;
        *)
            modules_to_stow+=( "$arg" )
            ;;
    esac
done

echo "arguments left over: ${*}"

