#!/usr/bin/env bash
# Stows or unstows selected or default dotfile modules for the detected OS

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STOW_SETS_DIR="$DOTFILES_DIR/stow-sets"

# --- Sources ---
source "${DOTFILES_DIR}/lib/log.sh"
source "${DOTFILES_DIR}/lib/detect-os.sh"
source "${DOTFILES_DIR}/lib/stow-actions.sh"

# --- Helpers ---
print_usage() {
    # TODO: add debug flag
    # TODO: consider adding an option to delete orphans
    # TODO: consider adding profile flags later for core, server and desktop
    echo "Usage:"
    echo "  $0                  Stow default modules"
    echo "  $0 -u               Unstow default modules"
    echo "  $0 modules...       Stow selected modules"
    echo "  $0 -u modules...    Unstow selected modules"
    echo ""
    echo "Options:"
    echo "  -u    Unstow instead of stow"
    echo "  -h    Show this help message"
}

run_stow_action() {
    local stow_action="$1"
    shift

    case "$stow_action" in
        stow)
            stow_all_modules "$@"
            ;;
        unstow)
            unstow_all_modules "$@"
            ;;
        *)
            error "Invalid stow action: $stow_action"
            ;;
    esac
}

# TODO: add function to make backups of files if they already exist (before stowing)
#       behavior will probably need to be added to the stow function instead of here

# --- Parse arguments ---
stow_action="stow"

# TODO: look into replacing for-loop with getopts function with while loop
# iterate over arguments
for arg in "$@"; do
    case "$arg" in
        -u)
            stow_action="unstow"
            shift
            ;;
        -h)
            print_usage
            exit 0
            ;;
        *)
            ;;
    esac
done

# --- Detect os ---
os="$(detect_os)"
info "OS: $os"

# --- Source os-specific modules ---
source "$STOW_SETS_DIR/common.sh"
source "$STOW_SETS_DIR/$os.sh"

# --- Select target modules ---
if [[ "$#" -gt 0 ]]; then
    target_modules=("$@")
else
    target_modules=(
        "${COMMON_MODULES[@]}"
        "${OS_MODULES[@]}"
    )
fi

# --- Debug ---
# printf '%s\n' "${target_modules[@]}"

# --- Stow / unstow modules ---
run_stow_action "$stow_action" "${target_modules[@]}"
