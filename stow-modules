#!/usr/bin/env bash
# Stows or unstows selected or default dotfile modules for the detected OS

# shellcheck disable=SC1090

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Sources ---
source "$DOTFILES_DIR/lib/log.sh"
source "$DOTFILES_DIR/lib/detect-os.sh"
source "$DOTFILES_DIR/lib/run-command.sh"

source "$DOTFILES_DIR/lib/validate-profile.sh"
source "$DOTFILES_DIR/lib/validate-os.sh"
source "$DOTFILES_DIR/lib/validate-manifest.sh"

source "$DOTFILES_DIR/lib/build-default-modules-for-profile.sh"

source "$DOTFILES_DIR/lib/stow-actions.sh"

# --- Helpers ---
print_usage() {
    local script_name
    script_name="./$( basename "$0")"

    # TODO: add debug flag
    # TODO: consider adding an option to delete orphans
    cat <<EOF
Usage:
    $script_name [options] [modules...]

Description:
    Stow modules by default.
    If no modules are provided, the default module set is used.
    If modules are provided, only those modules are used.

Options:
    -n              Dry run. Print commands without running them.
    -u              Unstow instead of stow
    -p PROFILE      Stow profile. Default: core.
    -h              Show this help message

Profiles:
    core     Bare terminal/dotfiles setup
    server   Core + development/build tools
    desktop  Server + GUI/workstation tools

Examples:
    $script_name                    # Stow default modules
    $script_name -n                 # Stow default modules
    $script_name -n nvim zsh tmux   # Stow selected modules
    $script_name nvim zsh tmux      # Stow selected modules
    $script_name -u                 # Unstow default modules
    $script_name -u nvim            # Unstow selected module
EOF
}

run_stow_action() {
    local stow_action="$1"
    shift

    case "$stow_action" in
        stow)
            stow_modules "$@"
            ;;
        unstow)
            unstow_modules "$@"
            ;;
        *)
            error "Invalid stow action: $stow_action"
            ;;
    esac
}

# TODO: add function to make backups of files if they already exist (before stowing)
#       behavior will probably need to be added to the stow function instead of here

# --- Parse arguments ---
stow_action="stow"

DRY_RUN=false
PROFILE="core"

while getopts ":nup:h" option; do
    case "$option" in
        n)
            title "Dry run enabled. No system changes will be made."
            DRY_RUN=true
            ;;
        p)
            validate_profile "$OPTARG" || exit 1
            PROFILE="$OPTARG"
            ;;
        u)
            stow_action="unstow"
            ;;
        h)
            print_usage
            exit 0
            ;;
        :)
            error "Option -$OPTARG requires an argument"
            print_usage
            exit 1
            ;;
        *)
            error "Invalid option: -$OPTARG"
            print_usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

# --- Detect os ---
OS="$(detect_os)"

validate-os "$OS" || exit 1

# --- Build default modules ---
source "$DOTFILES_DIR/manifests/$OS.sh"

validate_manifest || exit 1

DEFAULT_MODULES=()

build_default_modules_for_profile "$PROFILE" || exit 1

# --- Select target modules ---
if [[ "$#" -gt 0 ]]; then
    target_modules=("$@")
else
    target_modules=("${DEFAULT_MODULES[@]}")
fi

# --- Debug ---
# printf '%s\n' "${target_modules[@]}"

# --- Stow / unstow modules ---
title "Script Info"
info "PROFILE: $PROFILE"
info "OS: $OS"

run_stow_action "$stow_action" "${target_modules[@]}"
